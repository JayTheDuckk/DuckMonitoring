# Copy to .env and adjust. scripts/docker-up.sh does this for you.
COMPOSE_PROJECT_NAME=duck-monitoring
# Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

POSTGRES_DB=duck_monitoring
POSTGRES_USER=duck
POSTGRES_PASSWORD=change-me

ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: required by agents if you want a shared token
AGENT_API_TOKEN=

# Public UI port (nginx). API is proxied at /api on this port.
HTTP_PORT=3000
